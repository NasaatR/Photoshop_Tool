{
  "manifestVersion": 5,
  "id": "com.nasaat.pngrelay",
  "name": "Photoshop Tool",
  "version": "0.3.5",
  "main": "main.js",
  "host": {
    "app": "PS",
    "minVersion": "26.9.0",
    "data": {
      "apiVersion": 2,
      "enableMenuRecording": true
    }
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "relayPanel",
      "label": {
        "default": "Photoshop Tool"
      },
      "minimumSize": {
        "width": 176,
        "height": 96
      },
      "maximumSize": {
        "width": 4096,
        "height": 4096
      },
      "preferredDockedSize": {
        "width": 240,
        "height": 350
      },
      "preferredFloatingSize": {
        "width": 252,
        "height": 360
      }
    },
    {
      "type": "command",
      "id": "exportCopy",
      "label": {
        "default": "Export PNG + Copy"
      }
    },
    {
      "type": "command",
      "id": "copyImageOnly",
      "label": {
        "default": "Copy Composition"
      }
    },
    {
      "type": "command",
      "id": "selectionSmart",
      "label": {
        "default": "Selection to Smart Object + PNG + Copy"
      }
    },
    {
      "type": "command",
      "id": "exportPngOnly",
      "label": {
        "default": "Export PNG Only"
      }
    },
    {
      "type": "command",
      "id": "convertSmartObject",
      "label": {
        "default": "Convert to Smart Object"
      }
    },
    {
      "type": "command",
      "id": "smartCameraRaw",
      "label": {
        "default": "Smart Object + Camera Raw"
      }
    },
    {
      "type": "command",
      "id": "addBlackMask",
      "label": {
        "default": "Add Black Layer Mask"
      }
    },
    {
      "type": "command",
      "id": "addClippedCurves",
      "label": {
        "default": "Curves · Clipped to Layer"
      }
    },
    {
      "type": "command",
      "id": "addClippedHueSaturation",
      "label": {
        "default": "Hue/Saturation · Clipped to Layer"
      }
    },
    {
      "type": "command",
      "id": "addSolidColor",
      "label": {
        "default": "Add Solid Color Fill"
      }
    }
  ]
}
